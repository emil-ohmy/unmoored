    recoverTime: 1.2
    attack: Slam
    ranged: 0
  chain:
  - clip: Idle
    duration: 2.5
    loop: 1
    fade: 0
    note: 'standing, unaware: the heap on its hip'
    swipe: 
  - clip: Walk
    duration: 1.8
    loop: 1
    fade: 0.15
    note: 'it''s seen you: lumbering in, heap on the hip'
    swipe: 
