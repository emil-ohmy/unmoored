  - name: Slam
    windup: Windup
    strike: Strike
    recover: Recover
    telegraph: 0.9
    strikeTime: 0.3
    recoverTime: 1.2
    attack: Slam
    ranged: 0
  chain:
  - clip: Idle
    duration: 2.5
    loop: 1
    fade: 0
    note: 'standing, unaware: the heap on its hip'
    swipe: 
  - clip: Walk
    duration: 1.8
    loop: 1
    fade: 0.15
    note: 'it''s seen you: lumbering in, heap on the hip'
    swipe: 
  - clip: GuardUp
    duration: 0.35
    loop: 0
    fade: 0.05
    note: 'near: the heap comes up before its face'
    swipe: 
  - clip: GuardWalk
    duration: 1.6
    loop: 1
    fade: 0.15
    note: shuffling in behind it
    swipe: 
  - clip: Windup
    duration: 0.9
    loop: 0
    fade: 0.15
    note: 'Slam: the wind-up'
    swipe: 
  - clip: Strike
    duration: 0.3
    loop: 0
    fade: 0.05
    note: 'Slam: the blow'
    swipe: Slam
  - clip: Recover
    duration: 1.2
    loop: 0
    fade: 0.05
    note: 'Slam: recovering'
    swipe: 
  - clip: Walk
    duration: 0.033333335
    loop: 1
    fade: 0.15
    note: 'after you again (a moment: still near)'
    swipe: 
  - clip: GuardUp
    duration: 0.35
    loop: 0
    fade: 0.05
    note: ...so the guard comes up
    swipe: 
  - clip: GuardWalk
    duration: 1.2
    loop: 1
    fade: 0.15
    note: shuffling in behind it
    swipe: 
  - clip: Block
    duration: 0.3
    loop: 0
    fade: 0.05
    note: a blow turned on its guard
    swipe: 
  - clip: GuardWalk
    duration: 0.8
    loop: 1
    fade: 0.15
    note: shuffling in
    swipe: 
  - clip: SweepWindup
    duration: 0.6
    loop: 0
    fade: 0.15
    note: 'Sweep: the wind-up'
    swipe: 
  - clip: Sweep
    duration: 0.25
    loop: 0
    fade: 0.05
    note: 'Sweep: the blow'
    swipe: Sweep
  - clip: SweepRecover
    duration: 0.7
    loop: 0
    fade: 0.05
    note: 'Sweep: recovering'
    swipe: 
  - clip: Stagger
    duration: 1.2
    loop: 0
    fade: 0.05
    note: 'struck hard enough: staggered'
    swipe: 
